
# Lista de origens permitidas para CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# URL de conexão com o banco de dados
DATABASE_URL=mongodb://usuario:senha@host:porta/nome_do_banco

# Segredo usado para assinar tokens JWT
JWT_SECRET=uma_chave_secreta_segura

# Chave da API Resend (serviço de envio de emails) e credenciais de email
RESEND_API_KEY=sua_chave_resend
EMAIL_USER=seu_email@dominio.com
EMAIL_PASS=sua_senha_de_email

# Credenciais do Cloudinary
CLOUDINARY_API_KEY=sua_chave_cloudinary
CLOUDINARY_API_SECRET=sua_chave_secreta_cloudinary
CLOUDINARY_CLOUD_NAME=seu_nome_cloudinary
