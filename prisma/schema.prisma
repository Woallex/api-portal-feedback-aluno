datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Publication {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  category    String
  author      String?
  date        String
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  login     String   @unique
  password  String
  role      String   @default("user")
  favorites String[]
  twoFactorCode String?
  last2FADate String?
}