datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Publication {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  mediaUrl    String?
  mediaType   String?
  category    String
  date        String
  createdAt   DateTime @default(now())

  authorId    String   @db.ObjectId
  author      User     @relation(fields: [authorId], references: [id])
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  login     String   @unique
  password  String
  favorites String[]
  twoFactorCode String?
  last2FADate String?

  publications Publication[]
}

model RouteLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  route     String
  method    String
  createdAt DateTime @default(now())
}